# Amadeus API Configuration
# Get your API credentials from: https://developers.amadeus.com/

# Amadeus API Client ID (API Key)
VITE_AMADEUS_CLIENT_ID=your_client_id_here

# Amadeus API Client Secret
VITE_AMADEUS_CLIENT_SECRET=your_client_secret_here

# Amadeus API Base URL
# Use 'https://test.api.amadeus.com' for test environment
# Use 'https://api.amadeus.com' for production environment
VITE_AMADEUS_BASE_URL=https://test.api.amadeus.com
